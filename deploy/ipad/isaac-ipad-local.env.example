# Isaac on iPad (a-Shell) + local LLM server app
# Copy to ~/.isaac.env and fill in. Never commit real keys.
# Docs: docs/IPAD_ASHELL.md

# --- Choose ONE provider block ---

# (A) Local app speaks Ollama API on localhost
ACTIVE_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini

# (B) Local app speaks OpenAI-compatible API (uncomment; set A inactive)
# ACTIVE_PROVIDER=local
# LOCAL_LLM_ENABLED=1
# ISAAC_ALLOW_LOCAL_LLM=1
# LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
# LOCAL_LLM_MODEL=local-model
# LOCAL_LLM_TIMEOUT=300

# --- Kernel (foreground session on iPad) ---
ISAAC_DISABLE_VECTOR_MEMORY=1
ISAAC_BIND_HOST=127.0.0.1
MONITOR_HTTP_PORT=8766
MONITOR_PORT=8765
# ISAAC_FREE_CLOUD=0

# --- Optional cloud memory / ops (needs internet) ---
# ISAAC_COGNEE_ENABLED=1
# ISAAC_COGNEE_ALLOW_CLOUD=1
# COGNEE_BASE_URL=
# COGNEE_API_KEY=
# ISAAC_EXTERNAL_MEMORY_WRITE=1
# SENTRY_DSN=

# --- Keep heavy companions off until kernel is stable ---
# ISAAC_GROK_AGENT_ENABLED=0
# ISAAC_COPILOT_AGENT_ENABLED=0
# ISAAC_LETTA_ENABLED=0
# ISAAC_AUTO_PIPELINE=0
